{
  "name": "copycopy",
  "version": "1.0.0",
  "description": "漫画下载与管理桌面工具",
  "main": "./out/main/index.js",
  "author": "CopyCopy",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "test": "node scripts/run-security.mjs && node scripts/run-e2e.mjs && node scripts/run-protocol.mjs && node scripts/run-ad-policy.mjs",
    "test:ai": "node scripts/run-ai-e2e.mjs",
    "test:ad-policy": "node scripts/run-ad-policy.mjs",
    "test:security": "node scripts/run-security.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:protocol": "node scripts/run-protocol.mjs",
    "test:live": "npx esbuild scripts/live-test.ts --bundle --platform=node --format=cjs --external:electron --outfile=.tmp/live.cjs && electron .tmp/live.cjs"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^1.1.1",
    "js-yaml": "^4.1.0",
    "pdf-lib-plus-encrypt": "^1.1.0",
    "undici": "^7.30.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.4",
    "@vicons/ionicons5": "^0.13.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "esbuild": "^0.21.5",
    "naive-ui": "^2.40.3",
    "pinia": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.2.12"
  }
}
