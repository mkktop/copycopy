{
  "name": "copycopy",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "description": "CopyCopy · 原生漫画桌面客户端",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b --pretty false",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:ui": "playwright test",
    "test": "node scripts/check-architecture.mjs && playwright test",
    "format": "prettier --write src tests vite.config.ts playwright.config.ts",
    "format:check": "prettier --check src tests vite.config.ts playwright.config.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13"
  }
}
